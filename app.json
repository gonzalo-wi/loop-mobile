{
  "expo": {
    "name": "Loop",
    "slug": "react-nati",
    "version": "1.2.1",
    "orientation": "portrait",
    "scheme": "react-nati",
    "icon": "./assets/images/logoLoop.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.empresa.controlmercaderia"
    },
    "android": {
      "package": "com.empresa.controlmercaderia",
      "versionCode": 2,
      "permissions": [
        "REQUEST_INSTALL_PACKAGES",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logoLoop.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-asset",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "La app usa la cámara para escanear los códigos de barras de los dispensers."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logoLoop.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "http://localhost:8080",
      "router": {},
      "eas": {
        "projectId": "f80d2268-3ce8-4896-9ca5-10fe8e81fb80"
      }
    }
  }
}
